# Exchange settings
EWS_SERVER=mail.example.com
EWS_EMAIL=user@example.com
# IMPORTANT: .env values are taken literally — write a SINGLE backslash.
# (Double it only in YAML/shell where escaping applies, e.g. "DOMAIN\\user".)
EWS_USERNAME=DOMAIN\user
EWS_PASSWORD=changeme
# NTLM | BASIC | DIGEST
EWS_AUTH_TYPE=NTLM
# Keep "true". If you must use a self-signed certificate, prefer
# REQUESTS_CA_BUNDLE with your CA over disabling verification.
EWS_VERIFY_SSL=true

# Intervals (seconds)
UPDATE_INTERVAL=60
APPOINTMENT_REFRESH_INTERVAL=30
APPOINTMENT_NOTIFY_INTERVAL=900
MAIL_REFRESH_INTERVAL=60

# Unread mail fetch window (optional; defaults: 7 days, 100 messages)
MAIL_LOOKBACK_DAYS=7
MAIL_FETCH_LIMIT=100

# Telegram bots
APPOINTMENT_BOT_TOKEN=123456:ABCDEF
MAIL_BOT_TOKEN=123456:ABCDEF

# Chats allowed to use the bots and receive notifications
ALLOWED_CHAT_IDS=123456789,987654321
# Optional: where operational alerts go (Exchange auth failures etc.).
# Leave empty to send alerts to ALLOWED_CHAT_IDS via the appointment bot.
ADMIN_CHAT_ID=

# Timezone for display (IANA name)
LOCAL_TIMEZONE=Europe/Moscow

# Keywords for mail mention (comma-separated, optional; whole-word match)
KEYWORDS=urgent,asap
MENTION_TEXT=@nickname

# Daily agenda time on weekdays (local, optional, HH:MM)
AGENDA_TIME=06:10

# Workday start used for the "free window" before the first meeting (optional)
WORKDAY_START=09:00

# Show "Приватная встреча" instead of the subject for private meetings (optional)
MASK_PRIVATE_MEETINGS=false

# How often to retry after an Exchange authentication failure, seconds
# (kept long on purpose to avoid locking the domain account)
AUTH_RETRY_INTERVAL=1800

# Logging: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Where to keep notification state between restarts (optional; the Docker
# setup sets this to /data/state.json via docker-compose.yml)
STATE_FILE=
